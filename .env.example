# Discord Bot Token (https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Application / Client ID
CLIENT_ID=your_client_id_here

# Guild ID (dein Discord Server) — für guild-spezifische Commands (sofort aktiv)
# Weglassen für globale Commands (bis zu 1h Wartezeit)
GUILD_ID=your_guild_id_here

# Rollennamen (exakt wie in Discord, Groß-/Kleinschreibung beachten)
ADMIN_ROLE_NAME=Admin
COUNCIL_ROLE_NAME=Council
RAIDMEMBER_ROLE_NAME=Raidmember
TRIAL_ROLE_NAME=Trial
