# Discord Bot Token (https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Application / Client ID
CLIENT_ID=your_client_id_here

# Guild ID (dein Discord Server) — für guild-spezifische Commands (sofort aktiv)
# Weglassen für globale Commands (bis zu 1h Wartezeit)
GUILD_ID=your_guild_id_here

# Rollennamen (exakt wie in Discord, Groß-/Kleinschreibung beachten)
ADMIN_ROLE_NAME=Admin
COUNCIL_ROLE_NAME=Council
RAIDMEMBER_ROLE_NAME=Raidmember
TRIAL_ROLE_NAME=Trial

# Google Sheets Export (optional)
# Pfad zur Service Account JSON-Datei ODER den JSON-Inhalt direkt als String
GOOGLE_SERVICE_ACCOUNT_PATH=path/to/service-account-key.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ID des Google Sheets (aus der URL: .../spreadsheets/d/<ID>/edit)
GOOGLE_SHEET_ID=your_spreadsheet_id_here

# Name des Sheet-Tabs (optional, Standard: erster Tab)
# GOOGLE_SHEET_TAB=Roster
